---
import { render } from 'astro:content'
import type { PostLayoutProps as Props } from '@types'
import { postImages, postPage } from '@utils'
import Layout from './Layout.astro'
import PostHeader from '@components/post/PostHeader.astro'
import PostNav from '@components/post/PostNav.astro'
import TableOfContents from '@components/post/TableOfContents.astro'
import '@styles/layouts/PostLayout.css'

const { post } = Astro.props

const { slug, older, newer } = await postPage(post)
const { ogImage } = postImages(slug)

const { Content, headings } = await render(post)
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={ogImage}
  publishedTime={new Date(post.data.date).toISOString()}
  wide
>
  <article class="post-layout">
    <main>
      <PostHeader
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
      />
      <TableOfContents headings={headings} />
      <div class="post-content">
        <Content />
      </div>
      <PostNav older={older} newer={newer} />
    </main>
  </article>
</Layout>
